datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id           String     @id @default(cuid())
  email        String     @unique
  name         String?
  passwordHash String?
  role         Role       @default(VISITOR)
  downloads    Download[]
  orders       Order[]
  cart         Cart?
  createdAt    DateTime   @default(now())
}

enum Role {
  VISITOR
  CLIENT
  FASE
  ADMIN
}

model Artwork {
  id          String     @id @default(cuid())
  title       String
  slug        String     @unique
  description String?
  status      Status     @default(DRAFT)
  isFree      Boolean    @default(true)
  priceCents  Int        @default(1500)
  previewUrl  String
  files       File[]
  category    Category   @relation(fields: [categoryId], references: [id])
  categoryId  String
  tags        Tag[]
  downloads          Download[]
  orders             Order[]
  cartItems          CartItem[]
  orderItems         OrderItem[]
  collectionEntries  CollectionArtwork[]
  createdAt          DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

enum Status {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model File {
  id        String   @id @default(cuid())
  format    Format
  url       String
  size      Int
  artwork   Artwork  @relation(fields: [artworkId], references: [id])
  artworkId String
}

enum Format {
  CDR
  AI
  PDF
  OTF
  PNG
  JPG
}

model Category {
  id        String    @id @default(cuid())
  name      String    @unique
  slug      String    @unique
  color     String?
  showInFilter Boolean @default(true)
  filterOrder Int     @default(0)
  artworks  Artwork[]
}

model Tag {
  id       String    @id @default(cuid())
  name     String    @unique
  artworks Artwork[]
}

model Download {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id])
  userId    String
  artwork   Artwork  @relation(fields: [artworkId], references: [id])
  artworkId String
  fileId    String
  createdAt DateTime @default(now())
}

model Suggestion {
  id          String   @id @default(cuid())
  email       String?
  description String
  imageUrl    String?
  createdAt   DateTime @default(now())
}

enum OrderStatus {
  PENDING
  PAID
  FAILED
  EXPIRED
  REFUNDED
}

model Order {
  id             String      @id @default(cuid())
  user           User        @relation(fields: [userId], references: [id])
  userId         String
  artworkId      String?
  artwork        Artwork?    @relation(fields: [artworkId], references: [id])
  items          OrderItem[]
  couponId       String?
  coupon         Coupon?     @relation(fields: [couponId], references: [id])
  amountCents    Int
  status         OrderStatus @default(PENDING)
  mpPreferenceId String?
  mpPaymentId    String?     @unique
  paymentMethod  String?
  createdAt      DateTime    @default(now())
  paidAt         DateTime?
  updatedAt      DateTime    @updatedAt

  @@index([userId])
  @@index([artworkId])
  @@index([status])
}

model SupportTicket {
  id        String   @id @default(cuid())
  name      String
  email     String
  message   String
  status    String   @default("PENDING") // PENDING, RESOLVED
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Cart {
  id           String     @id @default(cuid())
  userId       String     @unique
  user         User       @relation(fields: [userId], references: [id])
  items        CartItem[]
  couponCode   String?
  discountCents Int       @default(0)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
}

model CartItem {
  id        String   @id @default(cuid())
  cartId    String
  cart      Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  artworkId String
  artwork   Artwork  @relation(fields: [artworkId], references: [id])
  createdAt DateTime @default(now())
}

enum DiscountType {
  PERCENTAGE
  FIXED
}

model Coupon {
  id              String        @id @default(cuid())
  code            String        @unique
  description     String?
  discountType    DiscountType
  discountValue   Int
  minPurchaseCents Int?
  maxUses         Int?
  usedCount       Int           @default(0)
  expiresAt       DateTime?
  isActive        Boolean       @default(true)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  orders          Order[]
}

model OrderItem {
  id          String  @id @default(cuid())
  orderId     String
  order       Order   @relation(fields: [orderId], references: [id])
  artworkId   String
  artwork     Artwork @relation(fields: [artworkId], references: [id])
  amountCents Int
}

model Collection {
  id          String               @id @default(cuid())
  title       String
  slug        String               @unique
  description String?
  artworks    CollectionArtwork[]
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
}

model CollectionArtwork {
  collectionId String
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  artworkId    String
  artwork      Artwork    @relation(fields: [artworkId], references: [id])
  order        Int        @default(0)

  @@id([collectionId, artworkId])
  @@index([artworkId])
}

